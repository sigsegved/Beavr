# Alpaca API Credentials
# Get your keys at https://app.alpaca.markets/
# paper trading account - https://paper-api.alpaca.markets/v2
ALPACA_API_KEY=your_api_key_here
ALPACA_API_SECRET=your_api_secret_here

# Use paper trading (set to false for live trading - not recommended for MVP)
ALPACA_PAPER=true

# Beavr Configuration (optional)
# BEAVR_DATA_DIR=~/.beavr
# BEAVR_DB_PATH=~/.beavr/beavr.db

# Telegram Bot (optional, for notifications & commands)
# Get a bot token from @BotFather on Telegram
BEAVR_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your Telegram chat ID (send /chatid to the bot to get it)
# BEAVR_MESSAGING__TELEGRAM__VERIFIED_CHAT_IDS=your_chat_id_here
# Enable messaging system
# BEAVR_MESSAGING__ENABLED=true
# BEAVR_MESSAGING__PROVIDER=telegram